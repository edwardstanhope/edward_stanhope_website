@article{yan2023,
  title = {Ketogenic {{Diet Combined}} with {{Moderate Aerobic Exercise Training Ameliorates White Adipose Tissue Mass}}, {{Serum Biomarkers}}, and {{Hepatic Lipid Metabolism}} in {{High-Fat Diet-Induced Obese Mice}}},
  author = {Yan, Jiabao and Ren, Cuiru and Dong, Yunlong and Wali, Jibran A. and Song, Hongjie and Zhang, Ying and Zhang, Hengrui and Kou, Guangning and Raubenheimer, David and Cui, Zhenwei},
  date = {2023-01-03},
  journaltitle = {Nutrients},
  shortjournal = {Nutrients},
  volume = {15},
  number = {1},
  pages = {251},
  issn = {2072-6643},
  doi = {10.3390/nu15010251},
  url = {https://www.mdpi.com/2072-6643/15/1/251},
  urldate = {2024-06-18},
  abstract = {Obesity is a serious public health issue worldwide. Growing evidence demonstrates the efficacy of the ketogenic diet (KD) for weight loss, but there may be some adverse side effects such as dyslipidemia and hepatic steatosis. Aerobic exercise is a widely recognized approach for improving these metabolic markers. Here we explored the combined impacts of KD and moderate aerobic exercise for an 8-week intervention on body weight and fat loss, serum biomarkers, and hepatic lipid metabolism in a mouse model of high-fat diet-induced obesity. Both KD and KD combined with exercise significantly reduced body weight and fat mass. No significant adverse effects of KD were observed in serum biomarkers or hepatic lipid storage, except for an increase in circulating triglyceride level. However, aerobic exercise lowered serum triglyceride levels, and further ameliorated serum parameters, and hepatic steatosis in KD-fed mice. Moreover, gene and protein expression analysis indicated that KD combined with exercise was associated with increased expression of lipolysis-related genes and protein levels, and reduced expression of lipogenic genes relative to KD without exercise. Overall, our findings for mice indicate that further work on humans might reveal that KD combined with moderate aerobic exercise could be a promising therapeutic strategy for obesity.},
  langid = {english},
  keywords = {animal,unprocessed},
  file = {C:\Users\es35\Zotero\storage\BKCUSD6Y\Yan et al_2023_Ketogenic Diet Combined with Moderate Aerobic Exercise Training Ameliorates.pdf}
}

