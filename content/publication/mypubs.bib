@article{manttari2018,
  title = {Six‐minute walk test: a tool for predicting maximal aerobic power ( {{{\textsc{VO}}}} {\textsubscript{2 }} max) in healthy adults},
  shorttitle = {Six‐minute walk test},
  author = {Mänttäri, Ari and Suni, Jaana and Sievänen, Harri and Husu, Pauliina and Vähä‐Ypyä, Henri and Valkeinen, Heli and Tokola, Kari and Vasankari, Tommi},
  date = {2018-11},
  journaltitle = {Clinical Physiology and Functional Imaging},
  shortjournal = {Clin Physio Funct Imaging},
  volume = {38},
  number = {6},
  pages = {1038--1045},
  issn = {1475-0961, 1475-097X},
  doi = {10.1111/cpf.12525},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/cpf.12525},
  urldate = {2024-06-14},
  abstract = {Summary                            Background                                The 6‐min walk test (6                 MWT                 ) is cost‐effective and well‐documented field test for assessing functional exercise capacity and response to medical interventions in diverse patient groups, and predicting cardiorespiratory fitness among healthy people.                                                        Objective                                Assessments of cardiorespiratory fitness in terms of maximal aerobic power (                 VO                 2                 max) have great potential in public health monitoring to predict future health, early retirement and ability to independent living. This study aimed to develop a prediction model for                 VO                 2                 max based on 6                 MWT                 results among healthy adults.                                                        Design                                The study comprised of pilot and validation studies. In validation study, seventy‐five 19‐ to 75‐year‐old adults (39 men, 36 women) were equipped with portable gas analyser and heart rate monitor. Participants performed 6                 MWT                 on a 15‐m indoor track and maximal graded exercise test (                 GXT                 ) on a treadmill. We evaluated performance of the developed prediction model among 1583 Finnish adults.                                                        Results                                Participant's mean walking distance was 652~m (                 SD                 ~±~74). Their mean                 VO                 2                 max in                 GXT                 and O                 2                 uptake at the end of the 6                 MWT                 were 34·4~ml~kg                 −1                 min                 −1                 (                 SD                 ~±~7·6) and 27·2 ~ml~kg                 −1                 min                 −1                 (                 SD                 ~±~6·5), respectively. For men, the best predictors for                 VO                 2                 max were walking distance, age,                 BMI                 , heart rate at the end of 6                 MWT                 and height, and for women, walking distance, age and weight. The predictors explained 82\% and 79\% of men's and women's measured                 VO                 2                 max with the standard error of estimate of 3·6~ml~kg                 −1                 min                 −1                 and 3·5~ml~kg                 −1                 min                 −1                 , respectively.                                                        Conclusion                                The 6                 MWT                 performed along a 15‐m track is a valid field test for predicting                 VO                 2                 max of healthy adults with accuracy of about 1                 MET                 .},
  langid = {english},
  keywords = {unprocessed,unread},
  file = {C:\Users\es35\Zotero\storage\4PXR9W8G\Mänttäri et al_2018_Six‐minute walk test.pdf}
}

@article{manttari2018,
  title = {Six‐minute walk test: a tool for predicting maximal aerobic power ( {{{\textsc{VO}}}} ₂ max) in healthy adults},
  shorttitle = {Six‐minute walk test},
  author = {Mänttäri, Ari and Suni, Jaana and Sievänen, Harri and Husu, Pauliina and Vähä‐Ypyä, Henri and Valkeinen, Heli and Tokola, Kari and Vasankari, Tommi},
  date = {2018-11},
  journaltitle = {Clinical Physiology and Functional Imaging},
  volume = {38},
  number = {6},
  pages = {1038--1045},
  issn = {1475-0961, 1475-097X},
  doi = {10.1111/cpf.12525},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/cpf.12525},
  urldate = {2024-06-14},
  abstract = {Summary Background The 6‐min walk test (6 MWT ) is cost‐effective and well‐documented field test for assessing functional exercise capacity and response to medical interventions in diverse patient groups, and predicting cardiorespiratory fitness among healthy people. Objective Assessments of cardiorespiratory fitness in terms of maximal aerobic power ( VO 2 max) have great potential in public health monitoring to predict future health, early retirement and ability to independent living. This study aimed to develop a prediction model for VO 2 max based on 6 MWT results among healthy adults. Design The study comprised of pilot and validation studies. In validation study, seventy‐five 19‐ to 75‐year‐old adults (39 men, 36 women) were equipped with portable gas analyser and heart rate monitor. Participants performed 6 MWT on a 15‐m indoor track and maximal graded exercise test ( GXT ) on a treadmill. We evaluated performance of the developed prediction model among 1583 Finnish adults. Results Participant's mean walking distance was 652 m ( SD  ± 74). Their mean VO 2 max in GXT and O 2 uptake at the end of the 6 MWT were 34·4 ml kg −1 min −1 ( SD  ± 7·6) and 27·2  ml kg −1 min −1 ( SD  ± 6·5), respectively. For men, the best predictors for VO 2 max were walking distance, age, BMI , heart rate at the end of 6 MWT and height, and for women, walking distance, age and weight. The predictors explained 82\% and 79\% of men's and women's measured VO 2 max with the standard error of estimate of 3·6 ml kg −1 min −1 and 3·5 ml kg −1 min −1 , respectively. Conclusion The 6 MWT performed along a 15‐m track is a valid field test for predicting VO 2 max of healthy adults with accuracy of about 1 MET .},
  langid = {english},
  keywords = {unprocessed,unread},
  file = {C:\Users\es35\Zotero\storage\TMRCGN38\Mänttäri et al_2018_Six‐minute walk test.pdf}
}

