@article{hassabi2023,
  title = {The role of moderate and high intensity supervised aerobic training in reducing steatosis and hepatic fibrosis in patients with non-alcoholic fatty liver disease; {{A}} randomized clinical trial},
  author = {Hassabi, Mohammad and Sadeghi, Amir and Abedy Yekta, Amir Hosein and Salehi, Shahin and Mahdaviani, Behnaz and Asgari, Ahmadreza and Poursaeid Esfahani, Mehrshad},
  date = {2023},
  journaltitle = {Gastroenterology and Hepatology from Bed to Bench},
  volume = {16},
  number = {1},
  issn = {2008-4234, 2008-2258},
  doi = {10.22037/ghfbb.v16i1.2466},
  url = {https://doi.org/10.22037/ghfbb.v16i1.2466},
  urldate = {2024-06-15},
  abstract = {Aim: This study aimed to compare the effect of the same volume of moderate- and high-intensity aerobic exercise on patients' liver steatosis and fibrosis. Background: Exercise is known strategy to deal with Non-Alcoholic Fatty Liver Disease (NAFLD). Methods: This Randomized Control Trial was performed on 60 patients randomly assigned to three arms of the study (1:1:1). Fibrosis and steatosis of liver including Control Attenuated Parameter (CAP) determined using Transient Elastography (TE). The control group was advised to adjust their lifestyle, as a routine management. The intervention groups additionally, participated on supervised exercise programs with two different intensities but the same volume of 1000 KCal per week. The intensities of 50\% and 70\% of V02 reserve were considered for moderate-intensity and vigorous programs, respectively. Results: On six-month follow-up, none of outcomes were statistically significant among three arms of study. However, changes in some outcomes were reached to statistically significant difference in follow-up in comparison with baseline. The mean of CAP score changes was -19.43 (31.43) (P=0.03), 9.92 (26.81) (P=0.21), and 14.61 (18.03) (P=0.01) in control, moderate- and high-intensity groups, respectively. In the high-intensity group, in addition to steatosis, this difference was also observed in the rate of fibrosis. Besides, the level of serum aminotransferases in the group with moderate exercise after six months had a significant decrease compared to baseline. (P=0.01) Conclusion: Improvement in steatosis and fibrosis was more evident in high- intensity group. As the rate of drop out was high, caution is needed in interpretation of the results.},
  langid = {english},
  keywords = {human,unprocessed},
  file = {C:\Users\es35\Zotero\storage\R5S355BD\Hassabi et al_2022_The role of moderate and high intensity supervised aerobic training in reducing.pdf}
}

