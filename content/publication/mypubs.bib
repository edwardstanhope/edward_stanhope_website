  urldate = {2024-06-14},
  abstract = {Inadequate study reporting precludes interpretation of findings, pooling of results in meta-analyses, and delays knowledge translation. While prehabilitation interventions aim to enhance candidacy for surgery, to our knowledge, a review of the quality of reporting in prehabilitation has yet to be conducted. Our objective was to determine the extent to which randomized controlled trials (RCTs) of prehabilitation are reported according to methodological and intervention reporting checklists.},
