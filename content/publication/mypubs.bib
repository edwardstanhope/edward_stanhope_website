@article{amitani2022,
  title = {Skeletal muscle loss during neoadjuvant chemotherapy predicts poor prognosis in patients with breast cancer},
  author = {Amitani, Masatsugu and Oba, Takaaki and Kiyosawa, Nami and Morikawa, Hiroki and Chino, Tatsunori and Soma, Ai and Shimizu, Tadafumi and Ohno, Koichi and Ono, Mayu and Ito, Tokiko and Kanai, Toshiharu and Maeno, Kazuma and Ito, Ken-ichi},
  date = {2022-03-26},
  journaltitle = {BMC Cancer},
  shortjournal = {BMC Cancer},
  volume = {22},
  number = {1},
  pages = {327},
  issn = {1471-2407},
  doi = {10.1186/s12885-022-09443-1},
  url = {https://doi.org/10.1186/s12885-022-09443-1},
  urldate = {2023-03-14},
  abstract = {The skeletal muscle index (SMI), which is calculated as the ratio of skeletal muscle area at the third lumbar vertebral level divided by height squared, has been considered a prognostic factor in patients with breast cancer. However, the prognostic impact of changes in SMI during treatment remains unclear. This study aimed to evaluate the influence of SMI changes in patients with breast cancer undergoing neoadjuvant chemotherapy (NAC).},
  file = {C\:\\Users\\es35\\Zotero\\storage\\BBFIQUC2\\Amitani et al. - 2022 - Skeletal muscle loss during neoadjuvant chemothera.pdf;C\:\\Users\\es35\\Zotero\\storage\\QFIUSXSD\\s12885-022-09443-1.html}
}

